# NMS Environment Configuration
# NO secrets here — all secrets live in Vault
# Reference Vault paths, not actual values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nms

# Redis (required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HashiCorp Vault
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT=secret
# Vault path references (not secrets):
VAULT_PATH_JWT_SECRET=nms/jwt/signing_key
VAULT_PATH_JWT_REFRESH_SECRET=nms/jwt/refresh_key
VAULT_PATH_DEVICE_CREDS=nms/devices
VAULT_PATH_VPN_PSK=nms/vpn/psk
# Fallback encryption key path (OS keyring env var — only if Vault unavailable)
APP_ENCRYPTION_KEY_ENV_VAR=NMS_ENCRYPTION_KEY

# IMS Integration
IMS_API_URL=http://ims.internal
IMS_M2M_CLIENT_ID=
IMS_M2M_VAULT_PATH=nms/ims/m2m_secret

# Zabbix
ZABBIX_API_URL=http://zabbix.internal/api_jsonrpc.php
ZABBIX_VAULT_PATH=nms/zabbix/api_token

# JWT Settings
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
JWT_ISSUER=nms
JWT_AUDIENCE=nms

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Notifications (multi-channel alert delivery)
# Master switch — when false, no notifications are sent.
NOTIFICATIONS_ENABLED=false

# Email channel (SMTP). Password lives in Vault, referenced by SMTP_VAULT_PATH.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS / 587), ssl (implicit TLS / 465), or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_VAULT_PATH=nms/notifications/smtp_password
SMTP_FROM_EMAIL=nms@example.com
SMTP_FROM_NAME=NMS Alerts
SMTP_TIMEOUT=10

# Telegram channel. Bot token lives in Vault, referenced by TELEGRAM_BOT_VAULT_PATH.
TELEGRAM_ENABLED=false
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_BOT_VAULT_PATH=nms/notifications/telegram_bot_token
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_TIMEOUT=10
